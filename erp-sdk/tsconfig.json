{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "#shared/*": ["./src/shared/*"],
      "#server/*": ["./src/server/*"],
      "#frontend/*": ["./src/frontend/*"]
    }
  },
  "include": ["src/**/*"]
}
