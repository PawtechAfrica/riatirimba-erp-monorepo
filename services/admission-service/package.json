{
    "name": "admission",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "node dist/index.js",
        "cron": "ts-node ./src/crons/cron-runner.ts",
        "dev": "nodemon",
        "build": "tsc && cp -r src/keys dist/",
        "deploy": "rm -rf ./dist && pnpm run build && npx mikro-orm cache:generate --combined --ts-node && cp -r ./temp ./dist",
        "migration:create": "mikro-orm migration:create",
        "migration:up": "mikro-orm migration:up",
        "migration:down": "mikro-orm migration:down",
        "seeder:run": "mikro-orm seeder:run",
        "schema:update": "mikro-orm schema:update --run",
        "schema:fresh": "mikro-orm schema:drop --run && mikro-orm schema:create --run",
        "test": "echo \"Error: no test specified\" && exit 1" 
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@11.7.0",
    "dependencies": {
        "@mikro-orm/cli": "^6.6.3",
        "@mikro-orm/core": "^6.6.3",
        "@mikro-orm/migrations": "^6.6.3",
        "@mikro-orm/postgresql": "^6.6.3",
        "@mikro-orm/reflection": "^6.6.3",
        "@mikro-orm/seeder": "^6.6.3",
        "axios": "^1.13.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "cors": "^2.8.5",
        "datejs": "1.0.0-rc3",
        "dayjs": "^1.11.19",
        "deep-object-diff": "^1.1.9",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "file-type": "^21.3.0",
        "form-data": "^4.0.5",
        "js-base64": "^3.7.8",
        "jsonwebtoken": "^9.0.3",
        "kenya-locations": "^0.2.0",
        "lodash": "^4.17.21",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "node-cron": "^4.2.1",
        "nodemon": "^3.1.11",
        "sanitize-filename": "^1.6.3",
        "sequelize": "^6.37.7",
        "sharp": "^0.34.5",
        "uuid": "^13.0.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0",
        "write-excel-file": "^2.3.10",
        "zod": "^4.4.3"
