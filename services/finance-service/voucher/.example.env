#supabase
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key
SUPABASE_URL=get_it_from_supabase

# Backup config
VOUCHER_API_BASE=http://localhost:3000/api/vouchers
SUPABASE_BUCKET=voucher-backup
BACKUP_RETENTION_DAYS=30

#postgres
VOUCHER_DB_USERNAME=your_username
VOUCHER_DB_PASSWORD=2002
VOUCHER_DB_NAME=your_database_name
VOUCHER_DB_HOST=your_hostname

#backup/clenup/scheduling timimgs
BACKUP_CRON=0 0 * * *
CLEANUP_CRON=0 1 * * 0
BACKUP_TIMEZONE=Africa/Nairobi



















 <div class="section">
      <div class="section-heading">Expenditure Voteheads</div>
      <table>
        <thead>
          <tr>
            <th class="col-date">Date</th>
            <th class="col-desc">Expenditure Votehead</th>
            <th class="col-kshs r">Kshs</th>
            <th class="col-cts  r">Cts</th>
          </tr>
        </thead>
        <tbody>
          ${vhRows}
          <tr class="total-row">
            <td colspan="2">Total</td>
            <td class="r">${vhTotalKshs.toLocaleString()}</td>
            <td class="r">${String(vhTotalCts).padStart(2, "0")}</td>
          </tr>
        </tbody>
      </table>
    </div>







