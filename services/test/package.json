{
  "name": "admission",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "build": "tsc",
    "deploy": "rm -rf ./dist && pnpm run build && npx mikro-orm cache:generate --combined --ts-node && cp -r ./temp ./dist",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "schema:update": "mikro-orm schema:update --run",
    "schema:fresh": "mikro-orm schema:drop --run && mikro-orm schema:create --run",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@mikro-orm/cli": "^6.4.16",
    "@mikro-orm/core": "^6.4.16",
    "@mikro-orm/migrations": "^6.4.16",
    "@mikro-orm/postgresql": "^6.4.16",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "datejs": "1.0.0-rc3",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.10",
    "sanitize-filename": "^1.6.3",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@mikro-orm/reflection": "^6.4.16",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.3"
  }
}
