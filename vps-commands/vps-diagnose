#!/usr/bin/env bash
set -u
# Standalone Compose discovery helpers (embedded in each command).
COMPOSE_FILE=""
COMPOSE_DIR=""

vps_find_compose() {
    local file
    local -a candidates=()
    # Optional override lets this command work with other VPS/project paths.
    if [[ -n "${VPS_COMPOSE_FILE:-}" ]]; then
        candidates+=("$VPS_COMPOSE_FILE")
    fi
    candidates+=(
        /srv/riatirimba-erp/docker-compose.yml
        /srv/riatirimba-erp/compose.yml
        /srv/riatirimba-erp/compose.yaml
        /srv/riatirimba-erp/docker-compose.yaml
        /srv/RIATIRIMBA-ERP/docker-compose.yml
        /srv/RIATIRIMBA-ERP/compose.yml
        /srv/RIATIRIMBA-ERP/compose.yaml
        /srv/RIATIRIMBA-ERP/docker-compose.yaml
    )
    for file in "${candidates[@]}"; do
        if [[ -f "$file" ]]; then
            COMPOSE_FILE="$(readlink -f "$file" 2>/dev/null || printf '%s' "$file")"
            COMPOSE_DIR="$(dirname "$COMPOSE_FILE")"
            return 0
        fi
    done
    echo "ERROR: Could not find a Docker Compose file." >&2
    echo "Set VPS_COMPOSE_FILE=/path/to/compose.yml and retry." >&2
    return 1
}

vps_compose() {
    (cd "$COMPOSE_DIR" && docker compose -f "$COMPOSE_FILE" "$@")
}

SERVICE="${1:-}"

if [[ $# -gt 1 ]]; then
    echo "Usage: vps-diagnose [service-name]"
    exit 2
fi

echo "======================================"
echo "      RIATIRIMBA DIAGNOSTICS"
echo "======================================"
echo "Time: $(date '+%Y-%m-%d %H:%M:%S %Z')"
echo "Host: $(hostname)"
echo

if ! docker info >/dev/null 2>&1; then
    echo "ERROR: Docker daemon is not responding."
    echo "Check: systemctl status docker"
    exit 1
fi

if ! vps_find_compose; then
    exit 1
fi

echo "Compose file: $COMPOSE_FILE"

if [[ -n "$SERVICE" ]]; then
    SERVICES="$(vps_compose config --services)" || exit 1
    if ! printf '%s\n' "$SERVICES" | grep -Fx -- "$SERVICE" >/dev/null; then
        echo "ERROR: '$SERVICE' is not a service in this Compose project."
        echo "Available services:"
        printf '%s\n' "$SERVICES"
        exit 2
    fi
    echo "Target service: $SERVICE"
else
    echo "Target: All services"
fi

echo
echo "---- Container status ----"
if [[ -n "$SERVICE" ]]; then
    vps_compose ps -a "$SERVICE"
else
    vps_compose ps -a
fi

echo
echo "---- Container details ----"
if [[ -n "$SERVICE" ]]; then
    CONTAINERS="$(vps_compose ps -a -q "$SERVICE")"
else
    CONTAINERS="$(vps_compose ps -a -q)"
fi

if [[ -z "$CONTAINERS" ]]; then
    echo "No containers found for the selected target."
else
    while IFS= read -r ID; do
        [[ -n "$ID" ]] || continue
        docker inspect --format \
'Name: {{.Name}}
Container: {{.Id}}
Image ID: {{.Image}}
State: {{.State.Status}}
Health: {{if .State.Health}}{{.State.Health.Status}}{{else}}no-healthcheck-configured{{end}}
Exit code: {{.State.ExitCode}}
Restart count: {{.RestartCount}}
Started: {{.State.StartedAt}}
' "$ID"
    done <<< "$CONTAINERS"
fi

echo
echo "---- Resource usage ----"
if [[ -n "$CONTAINERS" ]]; then
    # Intentional word splitting: CONTAINERS contains one Docker ID per line.
    # shellcheck disable=SC2086
    docker stats --no-stream $CONTAINERS \
        --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}' \
        2>/dev/null || echo "Resource stats unavailable."
else
    echo "No containers available for resource stats."
fi

echo
echo "---- Recent logs (last 100 lines per service) ----"
echo "Note: logs may contain sensitive application data."
if [[ -n "$SERVICE" ]]; then
    vps_compose logs --tail=100 --timestamps "$SERVICE"
else
    vps_compose logs --tail=100 --timestamps
fi

echo
echo "Diagnostics complete. No changes were made."
