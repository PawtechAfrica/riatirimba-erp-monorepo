#!/usr/bin/env bash
set -u
# Standalone Compose discovery helpers (embedded in each command).
COMPOSE_FILE=""
COMPOSE_DIR=""

vps_find_compose() {
    local file
    local -a candidates=()
    # Optional override lets this command work with other VPS/project paths.
    if [[ -n "${VPS_COMPOSE_FILE:-}" ]]; then
        candidates+=("$VPS_COMPOSE_FILE")
    fi
    candidates+=(
        /srv/riatirimba-erp/docker-compose.yml
        /srv/riatirimba-erp/compose.yml
        /srv/riatirimba-erp/compose.yaml
        /srv/riatirimba-erp/docker-compose.yaml
        /srv/RIATIRIMBA-ERP/docker-compose.yml
        /srv/RIATIRIMBA-ERP/compose.yml
        /srv/RIATIRIMBA-ERP/compose.yaml
        /srv/RIATIRIMBA-ERP/docker-compose.yaml
    )
    for file in "${candidates[@]}"; do
        if [[ -f "$file" ]]; then
            COMPOSE_FILE="$(readlink -f "$file" 2>/dev/null || printf '%s' "$file")"
            COMPOSE_DIR="$(dirname "$COMPOSE_FILE")"
            return 0
        fi
    done
    echo "ERROR: Could not find a Docker Compose file." >&2
    echo "Set VPS_COMPOSE_FILE=/path/to/compose.yml and retry." >&2
    return 1
}

vps_compose() {
    (cd "$COMPOSE_DIR" && docker compose -f "$COMPOSE_FILE" "$@")
}

echo "======================================"
echo "       RIATIRIMBA VPS HEALTH"
echo "======================================"
echo "Time: $(date '+%Y-%m-%d %H:%M:%S %Z')"
echo "Host: $(hostname)"
echo

echo "---- Docker daemon ----"
if docker info >/dev/null 2>&1; then
    echo "Docker: OK"
else
    echo "Docker: NOT RESPONDING"
    echo "Check: systemctl status docker"
    exit 1
fi

echo
echo "---- Uptime and load ----"
uptime

echo
echo "---- Memory and swap ----"
free -h

echo
echo "---- Disk space ----"
df -h / /srv 2>/dev/null | awk '!seen[$0]++'

echo
echo "---- Docker disk usage ----"
docker system df

echo
if vps_find_compose; then
    echo "---- Compose services ----"
    echo "File: $COMPOSE_FILE"
    vps_compose ps -a
else
    echo "WARNING: Compose file not found; service status unavailable."
fi

echo
echo "Health overview complete."
